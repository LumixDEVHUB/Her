    local function scanPF()
        local folder = WS:FindFirstChild("Players")
        if not folder or not folder:IsA("Folder") then return end
        local rows, isPF = {}, game.PlaceId == 292439477
        local localChar = App.LocalPlayer.Character
        if localChar and localChar.Parent and localChar.Parent.Parent == folder then cache.PFLocalTeam = localChar.Parent end
        for _, team in ipairs(folder:GetChildren()) do
            if team:IsA("Folder") then
                for _, model in ipairs(team:GetChildren()) do
                    if model:IsA("Model") then
                        local head, torso, label, limbs = nil, nil, nil, {}
                        for _, part in ipairs(model:GetChildren()) do
                            if part:IsA("BasePart") then
                                local l = billboard(part)
                                if l and not head then head, label, isPF = part, l, true
                                elseif part:FindFirstChildOfClass("SpotLight") and not torso then torso = part
                                else table.insert(limbs, part) end
                            end
                        end
                        if head and torso and label and label.Text ~= "" and model ~= localChar then
                            local color = label.TextColor3
                            local r, g, b = math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
                            local healthFrame = label:FindFirstChild("Health")
                            local percent = healthFrame and healthFrame:FindFirstChild("Percent")
                            local hp = percent and math.clamp(percent.Size.X.Scale, 0, 1) or 1
                            table.insert(rows, {char = model, key = model, name = label.Text, team = team, head = head,
                                root = torso, parts = {Head = head, Torso = torso, HumanoidRootPart = torso}, limbs = limbs,
                                enemy = math.abs(r - 255) <= 8 and math.abs(g - 10) <= 12 and math.abs(b - 20) <= 12,
                                percent = percent, health = hp, maxHealth = 1, r6 = true, source = "PF", tool = "None", position = torso.Position})
                        end
                    end
                end
            end
        end
        if isPF then
            cache.PFDetected = true
            cache.PF = rows
            local allZero = #rows > 0
            for _, p in ipairs(rows) do if p.health > 0 then allZero = false end end
            if allZero then for _, p in ipairs(rows) do p.health, p.percent = 1, nil end end
            if not cache.PFLocalTeam then
                local scores = {}
                for _, p in ipairs(rows) do scores[p.team] = (scores[p.team] or 0) + (p.enemy and 1 or -1) end
                local best, bestScore = nil, math.huge
                for team, score in pairs(scores) do if score < bestScore then best, bestScore = team, score end end
                cache.PFLocalTeam = best
            end
        end
    end
    local function radarFriends()
        local radar = App.LocalPlayer:FindFirstChild("PlayerGui")
        for _, name in ipairs({"MainGui", "Gameplay", "Middle", "Radar"}) do radar = radar and radar:FindFirstChild(name) end
        radar = radar and (radar:FindFirstChild("Radar") or radar)
        local names, ignore = {}, {LocalPlayer = true, Direction = true, Indicator = true, Map = true, A_Icon = true,
            B_Icon = true, RunningCircle = true, DamageIndicator = true, NoiseProximity = true, BuyMenu = true}
        if radar then for _, c in ipairs(radar:GetChildren()) do if not ignore[c.Name] then names[c.Name:gsub("_Dead$", "")] = true end end end
        return names
