    local indexes = {}
    for category, names in pairs(App.Categories) do indexes[category] = {}; for i, name in ipairs(names) do indexes[category][name] = i - 1 end end
    function cache.PositionPart(instance)
        if instance:IsA("BasePart") then return instance end
        if instance:IsA("Model") and instance.PrimaryPart then return instance.PrimaryPart end
        for _, c in ipairs(instance:GetChildren()) do
            if c:IsA("BasePart") then return c end
            for _, cc in ipairs(c:GetChildren()) do if cc:IsA("BasePart") then return cc end end
        end
        return nil
    end
    function cache.WorldClass(instance)
        local name, get = instance.Name, App.Get
        for _, definition in ipairs(App.WorldGroups) do
            local category, prefix = definition.category, "World." .. definition.prefix
            if get(prefix) then
                local index = indexes[category][name]
                if category == "tool" and index == nil then
                    for i, n in ipairs(App.Categories.tool) do if name:find(n, 1, true) then index = i - 1; break end end
                end
                if category == "keycard" then
                    if not instance:IsA("Folder") or name == "Keycards" or not name:find("Keycard", 1, true) then index = nil
                    else for i, n in ipairs(App.Categories.keycard) do if name:find(n, 1, true) then index = i - 1; break end end end
                elseif category == "crate" and not (instance:IsA("Model") or instance:IsA("MeshPart")) then index = nil end
                if index ~= nil and get(prefix .. "Sel[" .. index .. "]") then return category, index, prefix end
            end
        end
        if get("World.drops") and ((instance:IsA("Model") and (name == "DeadDrop" or name == "itemPickupModel"))
            or instance:IsA("Model") and instance.Parent and instance.Parent.Name == "Drops" and instance.Parent:IsA("Folder")) then return "drop", 0, "World.drops" end
        return nil
    end
    function cache.RefreshWorld(now)
        if not App.Get("World.enabled") then cache.World = {}; return end
        if cache.Scanning or now - cache.WorldLast < 2 then return end
        cache.WorldLast, cache.Scanning = now, true
        task.spawn(function()
            local ok, issue = pcall(function()
                local queue, at, out, seen = {WS}, 1, {}, {}
                local localChar = App.LocalPlayer.Character
                local root = localChar and localChar:FindFirstChild("HumanoidRootPart")
                local origin = root and root.Position or App.Camera and App.Camera.CFrame.Position or Vector3.zero
                local charSet = {}
                for _, p in ipairs(players:GetPlayers()) do if p.Character then charSet[p.Character] = true end end
                while at <= #queue and at <= 12000 and App.Alive and App.Get("World.enabled") do
                    local node = queue[at]; at = at + 1
                    if node.Parent or node == WS then
                        local category, index, prefix = cache.WorldClass(node)
                        local hum = node:IsA("Model") and node:FindFirstChildOfClass("Humanoid")
                        if not category and App.Get("World.soldiers") and hum and not charSet[node]
                            and node.Name ~= "thermalTemplate" and (node.Parent.Name == "NPCs" or node.Parent:FindFirstChild("NPCs") or node.Parent:FindFirstChild("thermalTemplate")) then
                            category, index, prefix = "npc", 0, "World.soldiers"
                        end
                        if category and not seen[node] then
                            local part = cache.PositionPart(node)
                            if category == "keycard" then
                                local stack, visited = {{node = node, depth = 0}}, 0
                                while #stack > 0 and visited < 60 do
                                    local entry = table.remove(stack); visited = visited + 1
                                    if entry.node:IsA("BasePart") and entry.node.Name == "HumanoidRootPart" then part = entry.node; break end
                                    if entry.depth < 3 then for _, c in ipairs(entry.node:GetChildren()) do table.insert(stack, {node = c, depth = entry.depth + 1}) end end
                                end
                            end
                            if part and part.Position ~= Vector3.zero and (part.Position - origin).Magnitude < 2500 and (not hum or hum.Health > 0) then
                                seen[node] = true
                                local name = node.Name
                                if category == "ore" then name = ({"Stone", "Phosphate", "Metal"})[index + 1]
                                elseif category == "animal" then name = ({"Deer", "WildBoar", "Wolf"})[index + 1]
                                elseif category == "tool" then name = App.Categories.tool[index + 1] end
                                table.insert(out, {node = node, part = part, name = name, category = category, index = index, prefix = prefix,
                                    hum = hum, root = node:FindFirstChild("HumanoidRootPart") or part, head = node:FindFirstChild("Head") or part})
                            end
                        end
                        for _, c in ipairs(node:GetChildren()) do table.insert(queue, c) end
                    end
                    if at % 300 == 0 then App.Services.RunService.Heartbeat:Wait() end
                end
                if App.Alive and App.Get("World.enabled") then cache.World = out end
            end)
            cache.Scanning = false
            if not ok and App.Alive then App.Message("World cache: " .. tostring(issue):sub(1, 120)) end
        end)
    end
end


do
    local mapping = {Space = 32, Tab = 9, Escape = 27, Return = 13, Backspace = 8, LeftControl = 17, RightControl = 17,
        LeftAlt = 18, RightAlt = 18, LeftShift = 304, RightShift = 305, CapsLock = 20, Insert = 45, Delete = 46,
        Home = 36, End = 35, PageUp = 33, PageDown = 34, Left = 37, Up = 38, Right = 39, Down = 40,
        Zero = 48, One = 49, Two = 50, Three = 51, Four = 52, Five = 53, Six = 54, Seven = 55, Eight = 56, Nine = 57,
        Quote = 222, Comma = 188, Minus = 189, Period = 190, Slash = 191, Semicolon = 186, Equals = 187,
        LeftBracket = 219, BackSlash = 220, RightBracket = 221, Backquote = 192}
    local names = {[0] = "Unbound", [1] = "Mouse 1", [2] = "Mouse 2", [4] = "Mouse 3", [5] = "Mouse X1*", [6] = "Mouse X2*", [16] = "Shift"}
    for name, code in pairs(mapping) do names[code] = name end
    for i = 65, 90 do mapping[string.char(i)] = i; names[i] = string.char(i) end
    for i = 1, 12 do mapping["F" .. i] = 111 + i; names[111 + i] = "F" .. i end
    function App.NormalizeKey(code) return App.ImGuiKeys[code] or code end
    function App.KeyName(code) code = App.NormalizeKey(code); return names[code] or ("VK " .. tostring(code)) end
    function App.InputCode(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then return 1 end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then return 2 end
        if input.UserInputType == Enum.UserInputType.MouseButton3 then return 4 end
        return mapping[input.KeyCode.Name]
    end
    function App.IsDown(code)
        code = App.NormalizeKey(code)
        if code == 16 then return App.Down[304] or App.Down[305] or false end
        return App.Down[code] == true
    end
    function App.Gate(id, key, mode, aim)
        if not App.Get(id) then return false end
        local keyCode, keyMode = App.NormalizeKey(App.Get(key) or 0), mode and App.Get(mode) or 0
        if keyMode == 2 then return true end
        if keyCode == 0 then return not aim end
        if not App.IsFocused() then return false end
        if keyMode == 1 then
            return aim and App.AimToggles[id] == true or not aim and App.SharedToggles[keyCode] == true
        end
