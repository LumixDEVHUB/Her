    function cache.Refresh(now)
        if now - cache.Last < ((cache.PFDetected or cache.CBDetected or cache.OPSDetected) and 0.1 or 0.5) then return end
        cache.Last = now
        cache.Players, cache.PF, cache.CB, cache.OPS, cache.ML = {}, {}, {}, {}, {}
        cache.PFDetected, cache.CBDetected, cache.OPSDetected, cache.MLDetected = false, false, false, false
        cache.PFLocalTeam, cache.CBLocalTeam = nil, nil
        for _, p in ipairs(players:GetPlayers()) do
            local row = cache.Record(p.Character, p, p.Name, p.Team, "Players")
            if row then table.insert(cache.Players, row) end
        end
        scanPF(); scanCB(); scanOPS(); scanML()
        if cache.PFDetected then cache.Active, cache.Mode = cache.PF, "PF"
        elseif cache.OPSDetected then cache.Active, cache.Mode = cache.OPS, "OPS"
        elseif cache.CBDetected then cache.Active, cache.Mode = cache.CB, "CB"
        elseif cache.MLDetected then cache.Active, cache.Mode = cache.ML, "ML"
        else cache.Active, cache.Mode = cache.Players, "Players" end
