do
    local Config = {Folder = "LUAHUB/configs", LastName = "default"}
    App.Config = Config
    local get, M = App.Get, App.Math
    function Config.EnsureFolder(folder)
        if not App.API.writefile or not App.API.makefolder or not App.API.isfolder then return false, "File operations are unavailable in this executor." end
        local path = ""
        for part in folder:gmatch("[^/]+") do
            path = path == "" and part or path .. "/" .. part
            if not App.API.isfolder(path) then App.API.makefolder(path) end
        end
        return true
    end
    function Config.Export()
        local lines, keys = {}, {}
        for key in pairs(App.Defaults) do table.insert(keys, key) end
        table.sort(keys)
        for _, key in ipairs(keys) do
            local value, kind = get(key), App.Kinds[key]
            local wireKey = key:gsub("%[(%d+)%]", "%1")
            local text
            if kind == "boolean" then text = value and "1" or "0"
            elseif kind == "rgba" then text = table.concat(value, ",")
            else text = tostring(value):gsub("[\r\n]", " ") end
            table.insert(lines, wireKey .. "=" .. text)
        end
        return table.concat(lines, "\n") .. "\n"
    end
    function Config.Validate(text)
        if type(text) ~= "string" or #text > 1024 * 1024 then return nil, "Invalid or oversized configuration." end
        local candidate, skipped, seen = M.Copy(App.Settings), {}, {}
        local aliases = {}
        for key in pairs(App.Defaults) do aliases[key:gsub("%[(%d+)%]", "%1")] = key end
        for line in text:gmatch("[^\r\n]+") do
            local name, raw = line:match("^%s*([^=]+)=(.*)$")
            if name then
                name = name:match("^%s*(.-)%s*$")
                local key = App.Kinds[name] and name or aliases[name]
                if key then
                    local kind, value = App.Kinds[key], nil
                    if kind == "boolean" then
                        if raw == "1" or raw == "true" then value = true elseif raw == "0" or raw == "false" then value = false else return nil, "Invalid boolean: " .. name end
                    elseif kind == "number" then
                        value = tonumber(raw); if not M.Finite(value) then return nil, "Invalid number: " .. name end
                    elseif kind == "rgba" then
                        value = {}; for token in raw:gmatch("[^,]+") do local number = tonumber(token); if not M.Finite(number) then return nil, "Invalid color: " .. name end; table.insert(value, math.clamp(number, 0, 1)) end
                        if #value ~= 4 then return nil, "RGBA needs four components: " .. name end
                    else value = raw:sub(1, 511) end
                    local spec = App.SpecById[key]
                    if spec and spec.reason then
                        value = M.Copy({v = App.Defaults[key]}).v
                        table.insert(skipped, key)
                    elseif spec and spec.options then
                        if value ~= math.floor(value) or value < 0 or value >= #spec.options then return nil, "Invalid choice: " .. name end
                        if spec.blocked and spec.blocked[value] then value = App.Defaults[key]; table.insert(skipped, key) end
                    elseif spec and spec.min then value = math.clamp(value, spec.min, spec.max) end
                    if name:match("KeyMode$") or key == "Freecam.keyMode" then value = math.clamp(math.floor(value), 0, 2) end
                    if name:match("Key$") or key == "Freecam.key" then
                        if value < 0 or value > 4096 or value ~= math.floor(value) then return nil, "Invalid key: " .. name end
                    end
                    candidate[key], seen[key] = value, true
                end
            end
        end
        if next(seen) == nil then return nil, "No recognized settings were found." end
        return candidate, skipped
    end
    function Config.Import(text)
        local candidate, skipped = Config.Validate(text)
        if not candidate then return false, skipped end
        App.Settings = candidate
        table.clear(App.SharedToggles); table.clear(App.AimToggles)
        App.Aim.Locked, App.Aim.Pending, App.Aim.Redirect = nil, nil, false
        App.Cache.WorldLast, App.Aim.Weapon = -10, nil
        for _, callbacks in pairs(App.Refreshers) do for _, fn in ipairs(callbacks) do fn() end end
        App.UI.ApplyTheme(); App.UI.Fit()
        return true, "Configuration loaded." .. (#skipped > 0 and " " .. #skipped .. " native or unused values were kept at source defaults." or "")
    end
    function Config.Path(name)
        name = tostring(name):gsub("%.config$", "")
        if not name:match("^[%w_-]+$") or #name > 64 then return nil, "Use 1–64 letters, numbers, underscores or hyphens." end
        return Config.Folder .. "/" .. name .. ".config"
    end
    function Config.Save(name)
        local path, issue = Config.Path(name); if not path then return false, issue end
        local ok, result = pcall(function()
            local ready, why = Config.EnsureFolder(Config.Folder); if not ready then error(why) end
            App.API.writefile(path, Config.Export())
        end)
        return ok, ok and "Saved " .. name .. ".config" or tostring(result)
    end
    function Config.Load(name)
        local path, issue = Config.Path(name); if not path then return false, issue end
        if not App.API.readfile then return false, "readfile is unavailable." end
        local ok, data = pcall(App.API.readfile, path)
        if not ok then return false, tostring(data) end
        return Config.Import(data)
    end
    function Config.Dump(filename, content)
        local ok, issue = pcall(function()
            local ready, why = Config.EnsureFolder("LUAHUB/dumps"); if not ready then error(why) end
            App.API.writefile("LUAHUB/dumps/" .. filename, content)
        end)
        return ok, ok and "Saved LUAHUB/dumps/" .. filename or tostring(issue)
    end
    function App.ExportText(title, content, filename)
        local UI = App.UI
