    end
    App.Services = {}
    for _, name in ipairs({"Players", "RunService", "UserInputService", "GuiService", "Lighting",
        "HttpService", "Stats", "CoreGui", "ContentProvider"}) do
        App.Services[name] = game:GetService(name)
    end
    App.Workspace = game:GetService("Workspace")
    App.LocalPlayer = App.Services.Players.LocalPlayer
    if not App.LocalPlayer then error("LUAHUB requires a Roblox client executor session.") end
    App.Camera = App.Workspace.CurrentCamera
