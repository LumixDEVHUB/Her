    local hotbarPanel = UI.Panel(UI.Overlay, {AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(420, 52), Visible = false})
    local hotbarText = UI.Text(hotbarPanel, "", 11, "textBright", {Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 1, -16), TextWrapped = true, Font = Enum.Font.Code})
    local hotbarButton = UI.Button(UI.Pages.Players, "Toggle replicated hotbar overlay", {Size = UDim2.new(1, -10, 0, 30)}, function() hotbarPanel.Visible = not hotbarPanel.Visible end)
    local frameCount, statsAt, lastUI = 0, os.clock(), -10
    local function updateUI(now)
        UI.Fit()
        local fontScale = get("Misc.menuFontSize")
        if fontScale ~= lastFont then
            lastFont = fontScale
            for _, instance in ipairs(UI.Gui:GetDescendants()) do
                if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
                    UI.FontBase[instance] = UI.FontBase[instance] or instance.TextSize
                    instance.TextSize = UI.FontBase[instance] * fontScale
                end
            end
        end
        local count = #App.Services.Players:GetPlayers()
        UI.Session.Text = App.Cache.Mode:upper() .. " CACHE  ·  " .. #App.Cache.Active .. " TARGETS  ·  " .. math.floor(App.FPS) .. " FPS  ·  " .. math.floor(App.Ping) .. " MS"
        local executor = "Executor not identified"
        if api.identifyexecutor then local ok, name = pcall(api.identifyexecutor); if ok then executor = tostring(name) end end
        UI.HomeSummary.Text = executor .. "\nPlace " .. tostring(game.PlaceId) .. "  ·  " .. count .. " players\n" .. App.Cache.Mode .. " target cache  ·  " .. #App.Cache.World .. " world objects\nWeapon: " .. get("Aimbot.detected_weapon_name")
        overlay.Visible = App.Gate("Misc.watermark", "Misc.watermarkKey", "Misc.watermarkKeyMode")
        watermark.Text = string.format("LUAHUB %s  ·  %d FPS  ·  %d players  ·  %d ms  ·  %s", App.Version, math.floor(App.FPS), count, math.floor(App.Ping), os.date("%H:%M:%S"))
        bindPanel.Visible = App.Gate("Misc.keybinds", "Misc.keybindsKey", "Misc.keybindsKeyMode")
        local lines = {"KEYBINDS"}
        local entries = {
            {"Aim", "Aimbot.enabled", "Aimbot.aimbotKey", "Aimbot.aimbotKeyMode", true},
            {"Trigger", "Aimbot.triggerbot", "Aimbot.triggerKey", "Aimbot.triggerKeyMode", true},
            {"Fly", "Movement.fly", "Movement.flyKey", "Movement.flyKeyMode"},
            {"Noclip", "Movement.noclip", "Movement.noclipKey", "Movement.noclipKeyMode"},
            {"Freecam", "Freecam.enabled", "Freecam.key", "Freecam.keyMode"},
            {"FOV", "Movement.fov", "Movement.fovKey", "Movement.fovKeyMode"},
        }
        for _, entry in ipairs(entries) do
            if get(entry[2]) then table.insert(lines, entry[1] .. "  [" .. App.KeyName(get(entry[3])) .. "]  " .. (App.Gate(entry[2], entry[3], entry[4], entry[5]) and "ON" or "idle")) end
        end
        bindText.Text, bindPanel.Size = table.concat(lines, "\n"), UDim2.fromOffset(238, #lines * 16 + 16)
        App.Selection.Update(now)
        if hotbarPanel.Visible then hotbarText.Text = "HOTBAR\n" .. UI.Backpack.Text:gsub("^Replicated hotbar: ", "") end
        local cap = get("Misc.fpsLimit")
        if cap ~= lastCap then
            if api.setfpscap and (lastCap ~= nil or cap > 0) then
                local ok, issue = pcall(api.setfpscap, cap)
                if ok then capChanged = true end
                if not ok then App.Message("FPS cap: " .. tostring(issue)) end
            end
            lastCap = cap
        end
    end
    function App.Unload()
        if not App.Alive then return end
        App.Alive = false
        App.Aim.Redirect = false
        for _, connection in ipairs(App.Connections) do pcall(function() connection:Disconnect() end) end
        pcall(function() App.Services.RunService:UnbindFromRenderStep("LUAHUB_Port_Render") end)
        if App.Freecam.Active then pcall(function() App.Services.UserInputService.MouseBehavior = App.Freecam.MouseBehavior end) end
        App.Mutations.Finish(true)
        if App.Movement.Flying then
            local _, _, root = App.Movement.Local()
            if root then pcall(function() root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero end) end
        end
        if capChanged and originalCap and api.setfpscap then pcall(api.setfpscap, originalCap) end
        local bus = App.Env.__LUAHUB_RAYCAST_BUS
        if bus and bus.owner == App then bus.owner = nil end
        for _, owned in ipairs(App.Owned) do pcall(function() owned:Destroy() end) end
        table.clear(App.Connections); table.clear(App.Owned); table.clear(App.Refreshers)
        table.clear(App.Aim.History); table.clear(App.Draw.Groups); table.clear(App.Selection.Rows)
        App.Drag, App.Capture = nil, nil
        if App.Env.LUAHUB_PORT == App then App.Env.LUAHUB_PORT = nil end
    end
    App.Connect(App.Workspace:GetPropertyChangedSignal("CurrentCamera"), function() App.Camera = App.Workspace.CurrentCamera; App.Aim.Locked = nil; UI.Fit() end)
    App.Connect(App.LocalPlayer.CharacterAdded, function()
        App.Aim.Locked, App.Cache.Last, App.Movement.HipHum = nil, -10, nil
    end)
    App.Connect(App.Services.Players.PlayerRemoving, function(player)
        App.Aim.History[player] = nil
        if App.Aim.Locked == player then App.Aim.Locked = nil end
    end)
    App.Services.RunService:BindToRenderStep("LUAHUB_Port_Render", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not App.Alive then return end
        local now = os.clock()
        App.Camera = App.Workspace.CurrentCamera
        frameCount = frameCount + 1
        if now - statsAt >= 0.5 then
            App.FPS = frameCount / math.max(0.001, now - statsAt)
            frameCount, statsAt = 0, now
            local ok, ping = pcall(function() return App.Services.Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            if ok and App.Math.Finite(ping) then App.Ping = ping end
        end
        App.Safe("Player cache", App.Cache.Refresh, now)
        App.Safe("World cache", App.Cache.RefreshWorld, now)
        App.Mutations.Begin()
        App.Safe("Movement", App.Movement.Tick, dt)
        App.Safe("Freecam", App.Freecam.Tick, dt)
        App.Safe("Lighting", App.TickLighting)
        App.Mutations.Finish()
        App.Safe("Aim", App.Aim.Tick, now)
        App.Safe("Visuals", App.Draw.Tick, now)
        if now - lastUI >= 0.25 then lastUI = now; App.Safe("Interface", updateUI, now) end
        if UI.Current == "Players" and UI.Window.Visible and App.Selection.Clone and get("previewSpin") then
            local radius = App.Selection.Radius or 12
            UI.PreviewCamera.CFrame = CFrame.lookAt(Vector3.new(math.sin(now * 0.5) * radius, radius * 0.1, math.cos(now * 0.5) * radius), Vector3.zero)
        end
    end)
    App.Cache.Refresh(os.clock())
    updateUI(os.clock())
    UI.Notify("Ready. RightShift or the LUA button opens the interface.")
end
return App

end, function(message) return debug.traceback(tostring(message), 2) end)
if not __ok then
    local app = __initializing
    if app then
        if app.Unload then pcall(app.Unload)
        else
            app.Alive = false
            if app.Services and app.Services.RunService then pcall(function() app.Services.RunService:UnbindFromRenderStep("LUAHUB_Port_Render") end) end
            if app.Mutations then pcall(app.Mutations.Finish, true) end
            for _, connection in ipairs(app.Connections) do pcall(function() connection:Disconnect() end) end
            for _, object in ipairs(app.Owned) do pcall(function() object:Destroy() end) end
            if app.Env and app.Env.LUAHUB_PORT == app then app.Env.LUAHUB_PORT = nil end
        end
    end
    error("LUAHUB initialization failed:\n" .. tostring(__result), 0)
end
return __result
