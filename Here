    App.FPS = 0
    App.Ping = 0
    App.Notice = "Ready. Gameplay features start disabled."
    function App.Connect(signal, fn)
        local connection = signal:Connect(fn)
        table.insert(App.Connections, connection)
        return connection
    end
    function App.Own(instance)
        table.insert(App.Owned, instance)
        return instance
    end
    function App.New(class, properties, parent)
        local instance = Instance.new(class)
        for key, value in pairs(properties or {}) do instance[key] = value end
        instance.Parent = parent
        return instance
    end
    function App.Message(text)
        App.Notice = tostring(text)
        if App.UI and App.UI.Notify then App.UI.Notify(App.Notice) end
    end
    function App.Safe(name, fn, ...)
        local ok, result = pcall(fn, ...)
        if not ok then
            local issue = tostring(result)
            if App.Errors[name] ~= issue then
                App.Errors[name] = issue
                warn("[LUAHUB/" .. name .. "] " .. issue)
                App.Message(name .. ": " .. issue:sub(1, 160))
            end
        end
        return ok, result
    end
    function App.IsFocused()
        if not App.Focused then return false end
        if App.Services.UserInputService:GetFocusedTextBox() then return false end
        if App.API.isrbxactive then
            local ok, active = pcall(App.API.isrbxactive)
            if ok and not active then return false end
        end
        return true
    end
    function App.MousePosition()
        return App.Services.UserInputService:GetMouseLocation()
    end
    function App.IsValid(instance)
        return instance ~= nil and instance.Parent ~= nil
    end
end


