        local ok, bytes = pcall(App.API.getscriptbytecode, node)
        if not ok or type(bytes) ~= "string" then App.Message("Bytecode is unavailable for this instance: " .. tostring(bytes)); return end
        local safeName = node.Name:gsub("[^%w_-]", "_"):sub(1, 64)
        local _, saveIssue = App.Config.Dump(safeName .. ".luauc", bytes)
        local lines = {"-- " .. node:GetFullName(), "-- Raw bytecode. No decompiler is included.", "-- " .. #bytes .. " bytes", "-- " .. saveIssue, ""}
        for at = 1, math.min(#bytes, 8192), 16 do
