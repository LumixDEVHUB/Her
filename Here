do
    local env = (type(getgenv) == "function" and getgenv()) or _G
    local current = getfenv()
    App.Env = env
    local previous = env.LUAHUB_PORT
    if type(previous) == "table" and type(previous.Unload) == "function" then
        pcall(previous.Unload)
    end
    env.LUAHUB_PORT = App
    App.API = {}
    for _, name in ipairs({"gethui", "protectgui", "hookmetamethod", "getnamecallmethod", "checkcaller",
        "newcclosure", "mousemoverel", "mouse1click", "isrbxactive", "isgameactive", "writefile",
        "readfile", "isfile", "isfolder", "makefolder", "listfiles", "setclipboard", "setrbxclipboard",
        "getscriptbytecode", "request", "http_request", "setfpscap", "getfpscap", "identifyexecutor"}) do
        local fn = env[name] or current[name]
        if type(fn) == "function" then App.API[name] = fn end
    end
    if not App.API.protectgui and type(syn) == "table" and type(syn.protect_gui) == "function" then
