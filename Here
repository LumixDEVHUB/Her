    end
    function cache.Parts(model)
        local parts = {}
        for _, child in ipairs(model:GetChildren()) do if child:IsA("BasePart") then parts[child.Name] = child end end
        for name, candidates in pairs(aliases) do
            if not parts[name] then for _, candidate in ipairs(candidates) do if parts[candidate] then parts[name] = parts[candidate]; break end end end
        end
        return parts
    end
    function cache.Record(character, owner, name, team, source)
        if not App.IsValid(character) or not character:IsA("Model") then return nil end
        local parts = cache.Parts(character)
        local root, head = parts.HumanoidRootPart, parts.Head
        if source == "OPS" then
            root = character:FindFirstChild("HumanoidRootPart")
            head = root
            if character.Parent ~= WS or not root or root.Parent ~= character or root.Position == Vector3.zero then return nil end
        end
        if not root or not head then return nil end
        local hum = character:FindFirstChildOfClass("Humanoid")
        local health, maxHealth = hum and hum.Health or 100, hum and hum.MaxHealth or 100
        if not App.Math.Finite(health) or health <= 0 then return nil end
        local role = "Innocent"
        if App.Get("ESP.enabled") and App.Get("ESP.flags") and App.Get("ESP.flagSel[7]") then
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("Tool") then
                    if child.Name == "Knife" or child:FindFirstChild("KnifeServer") then role = "Murder"; break end
                    if child.Name == "Gun" or child:FindFirstChild("GunServer") then role = "Sheriff"; break end
                end
            end
        end
        return {char = character, player = owner, key = owner or character, name = name or character.Name,
            team = team, root = root, head = head, hum = hum, health = health, maxHealth = maxHealth,
            parts = parts, r6 = parts.Torso ~= nil and parts.UpperTorso == nil, source = source or "Players",
            tool = cache.ToolName(character), localPlayer = owner == App.LocalPlayer, position = root.Position, role = role}
    end
    function cache.Live(record)
