    local function scanCB()
        local folder = WS:FindFirstChild("Characters")
        if not folder or not folder:IsA("Folder") then return end
        cache.CBDetected = true
        local mates = radarFriends()
        cache.CBLocalTeam = next(mates) and "RadarFriends" or nil
        local function add(model, team)
            if model.Name == App.LocalPlayer.Name then cache.CBLocalTeam = team or cache.CBLocalTeam; return end
            local owner = players:FindFirstChild(model.Name)
            local row = cache.Record(model, owner, model.Name, team or (mates[model.Name] and "RadarFriends" or nil), "CB")
            if row then table.insert(cache.CB, row) end
        end
        for _, c in ipairs(folder:GetChildren()) do
            if c:IsA("Model") then add(c)
            elseif c:IsA("Folder") and c.Name ~= "Hostages" then for _, model in ipairs(c:GetChildren()) do if model:IsA("Model") then add(model, c) end end end
        end
    end
    local function scanOPS()
        local folder = WS:FindFirstChild("Viewmodels") or WS:FindFirstChild("ViewModels")
        if not folder or not folder:IsA("Folder") then return end
        cache.OPSDetected, cache.Viewmodels = true, {}
        local viewmodels = {}
        local bodyNames = {shoulder1 = true, shoulder2 = true, torso = true, head = true,
            hip1 = true, hip2 = true, leg1 = true, leg2 = true, arm1 = true, arm2 = true, Model = true}
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") then
                local head, torso = model:FindFirstChild("head"), model:FindFirstChild("torso")
                local gui = head and head:FindFirstChild("Username")
                local label = gui and gui:FindFirstChild("Username")
                local name = model.Name == "LocalViewmodel" and App.LocalPlayer.Name or label and label:IsA("TextLabel") and label.Text
                if head and head:IsA("BasePart") and torso and torso:IsA("BasePart") then
                    local vm = {model = model, head = head, torso = torso, parts = cache.Parts(model),
                        name = name, isLocal = model.Name == "LocalViewmodel", tool = "None"}
                    for _, child in ipairs(model:GetChildren()) do
                        if child:IsA("Model") and not bodyNames[child.Name] then vm.tool = child.Name; break end
                    end
                    table.insert(viewmodels, vm)
                    if name and name ~= "" and not cache.Viewmodels[name] then cache.Viewmodels[name] = model end
                end
            end
        end
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= App.LocalPlayer then
                local model = p.Character or WS:FindFirstChild(p.Name)
                local row = cache.Record(model, p, p.Name, p.Team, "OPS")
                if row then
                    local selected
                    for _, vm in ipairs(viewmodels) do
                        if not vm.used and not vm.isLocal and vm.name == p.Name then selected = vm; break end
                    end
                    if not selected then
                        local best = 36
                        for _, vm in ipairs(viewmodels) do
                            if not vm.used and not vm.isLocal then
                                local delta = row.root.Position - vm.torso.Position
                                local distance = delta:Dot(delta)
                                if distance < best then selected, best = vm, distance end
                            end
                        end
                    end
                    row.r6, row.tool = false, "None"
                    row.parts = {Head = row.root, HumanoidRootPart = row.root, UpperTorso = row.root, LowerTorso = row.root}
                    if selected then
                        selected.used = true
                        row.viewmodel, row.head, row.tool = selected.model, selected.head, selected.tool
                        local v = selected.parts
                        row.parts = {Head = selected.head, HumanoidRootPart = row.root, UpperTorso = selected.torso, LowerTorso = selected.torso,
                            LeftUpperArm = v.shoulder1 or v.arm1, LeftLowerArm = v.arm1,
                            RightUpperArm = v.shoulder2 or v.arm2, RightLowerArm = v.arm2,
                            LeftUpperLeg = v.hip1 or v.leg1, LeftLowerLeg = v.leg1,
                            RightUpperLeg = v.hip2 or v.leg2, RightLowerLeg = v.leg2}
                    end
                    table.insert(cache.OPS, row)
                end
            end
        end
    end
    local function scanML()
        local owners = {}
        for _, p in ipairs(players:GetPlayers()) do if p.Character then owners[p.Character] = p end end
        local candidates, count = {}, 0
        for _, c in ipairs(WS:GetChildren()) do
            if c:IsA("Model") then table.insert(candidates, c)
            elseif c:IsA("Folder") and count < 40 then count = count + 1; for _, child in ipairs(c:GetChildren()) do if child:IsA("Model") then table.insert(candidates, child) end end end
        end
        local processed = 0
        for _, model in ipairs(candidates) do
            if model.Name == "Male" and processed < 400 then
                processed = processed + 1
                local owner = owners[model]
                local subject = App.Camera and App.Camera.CameraSubject
                if owner ~= App.LocalPlayer and model ~= App.LocalPlayer.Character and model ~= subject and model:FindFirstChildOfClass("Humanoid") ~= subject then
                    local row = cache.Record(model, owner, owner and owner.Name or "Male", owner and owner.Team, "ML")
