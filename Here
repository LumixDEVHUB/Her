do
    local M = {}
    App.Math = M
    function M.Finite(n) return type(n) == "number" and n == n and math.abs(n) < math.huge end
    function M.Color(rgba) return Color3.new(rgba[1], rgba[2], rgba[3]) end
    function M.Copy(t)
        local copy = {}
        for k, v in pairs(t) do copy[k] = type(v) == "table" and M.Copy(v) or v end
        return copy
    end
    function M.SmoothLook(current, want, smoothing)
        local k = math.clamp(1 / (smoothing <= 0.01 and 1 or smoothing), 0.01, 1)
        if want.Magnitude < 1e-6 then return current end
        local look = current.Unit + (want.Unit - current.Unit) * k
        return look.Magnitude > 1e-6 and look.Unit or current
    end
    function M.PredictFallen(position, camera, velocity, bulletVelocity, localVelocity, gravityMultiplier)
        if bulletVelocity <= 0 then return position end
        local distance = (position - camera).Magnitude
        if distance < 1 then return position end
        local original = position
        for _ = 1, 3 do
            local direction = (position - camera) * (distance > 0.1 and 1 / distance or 0)
            local effectiveVelocity = math.max(10, bulletVelocity + localVelocity:Dot(direction))
            local flight = distance / effectiveVelocity
            position = original + velocity * flight + Vector3.new(0, 0.5 * 196.2 * gravityMultiplier * flight * flight, 0)
            distance = (position - camera).Magnitude
        end
        return position
    end
    function M.GlobalPrediction(position, velocity, x, y)
        return position + Vector3.new(velocity.X * (10 - x) * 0.1, velocity.Y * (10 - y) * 0.1,
            velocity.Z * (10 - x) * 0.1)
    end
    function M.Spread(origin, target, amount, angleUnit, radiusUnit)
        if amount <= 0.001 then return target end
        local delta = target - origin
        if delta.Magnitude < 1e-4 then return target end
        local forward = delta.Unit
        local reference = math.abs(forward.Y) < 0.99 and Vector3.new(0, 1, 0) or Vector3.new(1, 0, 0)
        local right = forward:Cross(reference)
        if right.Magnitude > 1e-4 then right = right.Unit end
        local up = right:Cross(forward)
        local radius = math.sqrt(radiusUnit) * amount
        local angle = angleUnit * 6.2831853
        return target + right * (math.cos(angle) * radius) + up * (math.sin(angle) * radius)
    end
    function M.RaycastRedirect(origin, direction, target, wallbang)
        local delta = target - origin
        local distance, length = delta.Magnitude, direction.Magnitude
        if distance <= 0 or length <= 0 then return origin, direction end
        local forward = delta / distance
        if wallbang then return target - forward * 1.15, forward * (length + 1.15) end
        return origin, forward * length
    end
    function M.FlyVelocity(current, target, damping, dt)
        local t = math.clamp(dt, 0.001, 0.05)
        if damping <= 0 then return target end
        return current + (target - current) * (1 - math.exp(-damping * t))
    end
    function M.FreecamFrame(pitch, yaw, position)
        local cy, sy, cp, sp = math.cos(yaw), math.sin(yaw), math.cos(pitch), math.sin(pitch)
        return CFrame.new(position.X, position.Y, position.Z, cy, sy * sp, sy * cp,
            0, cp, -sp, -sy, cy * sp, cy * cp)
    end
    function M.StaticBounds(head, root, r6, project)
        local top = project(head + Vector3.new(0, 0.5, 0))
        local bottom = project(root - Vector3.new(0, r6 and 3 or 2.5, 0))
        if not top or not bottom then return nil end
        local height = bottom.Y - top.Y
        local width = height * 0.55
        return top.X - width / 2, top.Y, top.X + width / 2, bottom.Y
    end
    function M.DynamicBounds(points, project)
        local x0, x1, y0, y1 = math.huge, -math.huge, math.huge, -math.huge
        for _, p in ipairs(points) do
            local s = project(p)
            if s then x0, x1, y0, y1 = math.min(x0, s.X), math.max(x1, s.X), math.min(y0, s.Y), math.max(y1, s.Y) end
        end
        if x0 == math.huge then return nil end
        local padding = math.clamp((y1 - y0) * 0.06, 3, 10)
        return x0 - padding * 0.8, y0 - padding, x1 + padding * 0.8, y1 + padding
    end
    function M.SanityBox(distance, x0, y0, x1, y1, focal)
        local width, height = x1 - x0, y1 - y0
        distance = math.max(1, distance)
        return height > 3 and width > 2 and height <= 5.5 * focal / distance * 3 + 30
            and width <= 2.4 * focal / distance * 4 + 30
    end
    function M.SampleHistory(samples, now)
        while #samples > 0 and now - samples[1].t > 0.45 do table.remove(samples, 1) end
        local n = #samples
        if n < 3 then return nil end
        local st, stt, sx, sy, sz, stx, sty, stz = 0, 0, 0, 0, 0, 0, 0, 0
        local ymin, ymax = samples[1].p.Y, samples[1].p.Y
        for _, s in ipairs(samples) do
            local t, p = s.t - samples[1].t, s.p
            st, stt = st + t, stt + t * t
            sx, sy, sz = sx + p.X, sy + p.Y, sz + p.Z
            stx, sty, stz = stx + t * p.X, sty + t * p.Y, stz + t * p.Z
            ymin, ymax = math.min(ymin, p.Y), math.max(ymax, p.Y)
        end
        local denominator = n * stt - st * st
        if math.abs(denominator) < 1e-6 then return nil end
        local vx, vy, vz = (n * stx - st * sx) / denominator, (n * sty - st * sy) / denominator, (n * stz - st * sz) / denominator
        local damping = 1
        if n >= 5 then
            local ax, az, bx, bz, ca, cb = 0, 0, 0, 0, 0, 0
            local half = math.floor(n / 2)
            for i = 2, n do
                local dt = samples[i].t - samples[i - 1].t
                if dt >= 1e-4 then
                    local delta = (samples[i].p - samples[i - 1].p) / dt
                    if i - 1 <= half then ax, az, ca = ax + delta.X, az + delta.Z, ca + 1
                    else bx, bz, cb = bx + delta.X, bz + delta.Z, cb + 1 end
                end
            end
            local al, bl = math.sqrt(ax * ax + az * az), math.sqrt(bx * bx + bz * bz)
            if ca > 0 and cb > 0 and al > 1 and bl > 1 then
                local cosine = (ax * bx + az * bz) / (al * bl)
                if cosine < 1 then damping = math.clamp(0.45 + 0.55 * (cosine * 0.5 + 0.5), 0.45, 1) end
            end
        end
        return Vector3.new(vx * damping, vy, vz * damping), math.abs(vy) > 6 or ymax - ymin > 3.5, damping
    end
    App.Settings = M.Copy(App.Defaults)
    App.Refreshers = {}
    function App.Get(id) return App.Settings[id] end
    function App.Set(id, value, quiet)
        local kind = App.Kinds[id]
        if not kind then return false, "Unknown setting: " .. tostring(id) end
        if kind == "number" and not M.Finite(value) then return false, "A finite number is required." end
        if kind == "rgba" then
            if type(value) ~= "table" or #value ~= 4 then return false, "RGBA requires four values." end
            for i = 1, 4 do if not M.Finite(value[i]) then return false, "Invalid color." end end
            value = {math.clamp(value[1], 0, 1), math.clamp(value[2], 0, 1), math.clamp(value[3], 0, 1), math.clamp(value[4], 0, 1)}
        elseif kind ~= "rgba" and type(value) ~= (kind == "number" and "number" or kind) then
            return false, "Incorrect value type."
        end
        local spec = App.SpecById and App.SpecById[id]
        if spec and spec.reason and value ~= App.Defaults[id] then return false, spec.reason end
        if spec and spec.min then value = math.clamp(value, spec.min, spec.max) end
        if spec and spec.options then
            if value ~= math.floor(value) or value < 0 or value >= #spec.options then return false, "Invalid selection." end
            if spec.blocked and spec.blocked[value] then return false, spec.blocked[value] end
        end
        if id:match("KeyMode$") or id == "Freecam.keyMode" then
            if value < 0 or value > 2 or value ~= math.floor(value) then return false, "Key mode must be Hold, Toggle or Always." end
        elseif id:match("Key$") or id == "Freecam.key" then
            if value < 0 or value > 4096 or value ~= math.floor(value) then return false, "Invalid key code." end
        end
        App.Settings[id] = value
        if App.Refreshers[id] then for _, fn in ipairs(App.Refreshers[id]) do fn() end end
        if id:sub(1, 6) == "Theme." and App.UI and App.UI.ApplyTheme then App.UI.ApplyTheme() end
        if not quiet and spec and spec.note then App.Message(spec.note) end
        return true
    end
end


do
    local WS, players = App.Workspace, App.Services.Players
