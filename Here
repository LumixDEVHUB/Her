    App.Friends, App.Targets = {}, {}
    local aliases = {
        Head = {"Head", "FakeHead", "head"}, HumanoidRootPart = {"HumanoidRootPart", "Torso", "torso"},
        Torso = {"Torso", "torso"}, UpperTorso = {"UpperTorso", "torso"}, LowerTorso = {"LowerTorso"},
        ["Left Arm"] = {"Left Arm", "arm1"}, ["Right Arm"] = {"Right Arm", "arm2"},
        ["Left Leg"] = {"Left Leg", "leg1"}, ["Right Leg"] = {"Right Leg", "leg2"},
    }
    function cache.ToolName(character)
        if not App.IsValid(character) then return "None" end
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then return tool.Name end
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Model") and child.Name ~= "HolsterModel" and child.Name ~= "CharacterArmor"
                and (child:FindFirstChild("Handle") or child:FindFirstChild("Main")) then return child.Name end
