do
    local Aim = {History = {}, LastAcquire = 0, LastTrigger = 0, LastWeapon = 0, Pending = nil, HasTarget = false, ShownAt = -10}
    App.Aim = Aim
    local get, cache, M, WS = App.Get, App.Cache, App.Math, App.Workspace
    local hitParts = {
        [0] = {"Head"}, [1] = {"Torso", "UpperTorso", "LowerTorso"}, [2] = {"Left Arm", "LeftUpperArm", "LeftLowerArm", "LeftHand"},
        [3] = {"Right Arm", "RightUpperArm", "RightLowerArm", "RightHand"}, [4] = {"Left Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot"},
        [5] = {"Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot"}, [6] = {"HumanoidRootPart"},
    }
    function Aim.Project(position, unlimited)
        local camera = App.Camera
        if not camera then return nil end
        local p, onScreen = camera:WorldToViewportPoint(position)
        if not unlimited and (p.Z <= 0.001 or not onScreen) then return nil end
        if unlimited and p.Z <= 0.001 then return Vector2.zero end
        return Vector2.new(p.X, p.Y)
    end
    function Aim.Visible(position, record)
        if not App.Camera then return true end
        local origin = App.Camera.CFrame.Position
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local excludes = {App.Camera}
        if App.LocalPlayer.Character then table.insert(excludes, App.LocalPlayer.Character) end
        if record and record.char then table.insert(excludes, record.char) end
        params.FilterDescendantsInstances = excludes
        params.IgnoreWater, params.RespectCanCollide = true, true
        return WS:Raycast(origin, position - origin, params) == nil
    end
    function Aim.Eligible(record, trigger, tracking)
        if record.localPlayer or not cache.Live(record) or App.Friends[record.name] then return false end
        local marked = App.Targets[record.name]
        if App.TeamCheck() and cache.Teammate(record) and not (tracking and marked) then return false end
        if not trigger and record.source ~= "PF" then
            if get("Aimbot.knockCheck") and record.maxHealth > 0 and record.health <= 0 then return false end
            if get("Aimbot.healthCheck") and record.health < get("Aimbot.minHealth") then return false end
            if get("Aimbot.forcefieldCheck") and record.char:FindFirstChildOfClass("ForceField") then return false end
        end
        return true
    end
    function Aim.BestPart(record, center, limit, visible)
        local mode, candidates, unlimited = get("Aimbot.aimTarget"), {}, limit >= 1e8
        if record.source == "PF" then
            candidates, mode = {record.head, record.root}, 0
        elseif mode == 7 then
            local stack = {record.char}
            while #stack > 0 and #candidates < 64 do
                local node = table.remove(stack)
                if node:IsA("BasePart") then table.insert(candidates, node) end
                local children = node:GetChildren()
                for i = 1, math.min(#children, 64) do table.insert(stack, children[i]) end
            end
        else
            for _, name in ipairs(hitParts[mode] or hitParts[0]) do
                local part = record.parts[name]
                if part then table.insert(candidates, part); break end
            end
            for _, part in ipairs({record.head, record.parts.Torso or record.parts.UpperTorso, record.root}) do
                if part and not table.find(candidates, part) then table.insert(candidates, part) end
            end
        end
        local best, bestPart, bestScreen, bestWorld = limit, nil, nil, nil
        for _, part in ipairs(candidates) do
            if App.IsValid(part) and part.Position ~= Vector3.zero then
                local world = part.Position
                local screen = Aim.Project(world, unlimited)
                if screen then
                    local distance = (screen - center).Magnitude
                    if (unlimited or distance < best) and (not visible or Aim.Visible(world, record)) then
                        best, bestPart, bestScreen, bestWorld = distance, part, screen, world
                        if mode ~= 7 then return bestPart, bestScreen, bestWorld end
                    end
                end
            end
        end
        return bestPart, bestScreen, bestWorld
    end
    local function weaponName()
        local model = cache.Viewmodels and cache.Viewmodels[App.LocalPlayer.Name]
        if model then
            for _, c in ipairs(model:GetChildren()) do if App.FallenWeapons[c.Name] then return c.Name end end
        end
        return cache.ToolName(App.LocalPlayer.Character)
    end
    function Aim.UpdateWeapon(now)
        if now - Aim.LastWeapon < 0.5 then return end
        Aim.LastWeapon = now
        local selected = get("Aimbot.selected_weapon_index")
        local name = selected == 0 and weaponName() or App.FallenList[selected + 1]
        if selected == #App.FallenList - 1 then App.Settings["Aimbot.detected_weapon_name"] = "Custom / Manual"; return end
        if not name or name == "None" or name == "" then return end
        if name ~= Aim.Weapon or selected ~= Aim.SelectedWeapon then
            local data = App.FallenWeapons[name]
            App.Set("Aimbot.fallen_bv_override", data and data[1] or 0, true)
            App.Set("Aimbot.fallen_grav_mult", data and data[2] or 0, true)
            App.Settings["Aimbot.detected_weapon_name"] = name
            Aim.Weapon, Aim.SelectedWeapon = name, selected
        end
    end
    function Aim.PushHistory(key, position, now)
        local samples = Aim.History[key] or {}
        Aim.History[key] = samples
        table.insert(samples, {p = position, t = now})
        while #samples > 14 do table.remove(samples, 1) end
        return M.SampleHistory(samples, now)
    end
    function Aim.Predict(record, world, now)
        local velocity = Aim.PushHistory(record.key, world, now) or record.root.AssemblyLinearVelocity
        local camera = App.Camera.CFrame.Position
        if get("Aimbot.prediction") then
            Aim.UpdateWeapon(now)
            if get("Aimbot.fallen_prediction") then
                local bv = get("Aimbot.fallen_bv_override")
                if bv <= 0 then local data = App.FallenWeapons[weaponName()]; bv = data and data[1] or 0 end
                local char = App.LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if bv > 0 then world = M.PredictFallen(world, camera, velocity, bv, root and root.AssemblyLinearVelocity or Vector3.zero, get("Aimbot.fallen_grav_mult")) end
            else world = world + velocity * (math.max(0, App.Ping) / 1000 + 0.016) end
        end
        if get("Aimbot.globalPrediction") and record.source ~= "NPC" then
            world = M.GlobalPrediction(world, record.root.AssemblyLinearVelocity, get("Aimbot.predX"), get("Aimbot.predY"))
        end
        return world
    end
    function Aim.InstallRaycast()
        if Aim.HookReady then return true end
        local api = App.API
        if not (api.hookmetamethod and api.getnamecallmethod and api.checkcaller and api.newcclosure) then
            App.Message("Raycast adapter needs hookmetamethod, getnamecallmethod, checkcaller and newcclosure.")
            return false
        end
        local bus = App.Env.__LUAHUB_RAYCAST_BUS
        if not bus then
            bus = {owner = App}
            local previous
            local ok, issue = pcall(function()
                previous = api.hookmetamethod(game, "__namecall", api.newcclosure(function(self, ...)
                    local owner = bus.owner
                    if owner and owner.Alive and not api.checkcaller() and self == owner.Workspace and api.getnamecallmethod() == "Raycast"
                        and owner.Aim.Redirect and owner.Aim.TargetWorld then
                        local args = table.pack(...)
                        if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                            args[1], args[2] = owner.Math.RaycastRedirect(args[1], args[2], owner.Aim.TargetWorld, true)
                            return previous(self, table.unpack(args, 1, args.n))
                        end
                    end
                    return previous(self, ...)
                end))
            end)
            if not ok then App.Message("Raycast adapter: " .. tostring(issue)); return false end
            bus.original = previous
            App.Env.__LUAHUB_RAYCAST_BUS = bus
        end
        bus.owner = App
        Aim.HookReady = true
        return true
    end
    function Aim.Apply(record, screen, world, now)
        Aim.HasTarget, Aim.Target, Aim.TargetWorld, Aim.TargetScreen, Aim.ShownAt = true, record, world, screen, now
        local delta = screen - App.MousePosition()
        if record.source ~= "PF" and get("Aimbot.useDeadzone") and delta.Magnitude <= get("Aimbot.deadzone") then Aim.Redirect = false; return end
        local method = get("Aimbot.aimMethod")
        local magic = method == 2 or (record.source == "PF" and get("Aimbot.magicBullet")) or (method ~= 0 and method ~= 1 and method ~= 4 and get("Aimbot.magicBullet"))
        if magic then
            local finalWorld = world
            if get("Aimbot.useSpread") and get("Aimbot.spreadModifier") > 0.001 and math.random() * 100 > get("Aimbot.hitChance") then
                finalWorld = M.Spread(App.Camera.CFrame.Position, world, get("Aimbot.spreadModifier"), math.random(), math.random())
            end
            Aim.TargetWorld, Aim.Redirect = finalWorld, Aim.InstallRaycast()
        elseif method == 0 then
            local camera = App.Camera
            local position = camera.CFrame.Position
            if position == Vector3.zero then return end
            local direction = world - position
            if direction.Magnitude > 1e-6 then
                local look = M.SmoothLook(camera.CFrame.LookVector, direction.Unit, get("Aimbot.smoothing"))
                local up = math.abs(look:Dot(Vector3.yAxis)) > 0.999999 and Vector3.zAxis or Vector3.yAxis
                camera.CFrame = CFrame.lookAt(position, position + look, up)
            end
        elseif method == 4 then
            if App.API.mousemoverel then
                local smoothing = math.max(1, get("Aimbot.smoothing"))
                local dx, dy = delta.X / smoothing, delta.Y / smoothing
                App.API.mousemoverel(dx >= 0 and math.floor(dx) or math.ceil(dx), dy >= 0 and math.floor(dy) or math.ceil(dy))
            elseif not Aim.MouseWarned then Aim.MouseWarned = true; App.Message("Mouse aim requires mousemoverel.") end
        end
    end
    function Aim.Tick(now)
        Aim.HasTarget, Aim.Redirect = false, false
        if not App.Camera or not App.IsFocused() then Aim.Pending = nil; return end
        local center, list = App.MousePosition(), cache.Active
        local visible = get("Aimbot.visibleCheck")
        Aim.TriggerActive = App.Gate("Aimbot.triggerbot", "Aimbot.triggerKey", "Aimbot.triggerKeyMode", true)
        Aim.Active = App.Gate("Aimbot.enabled", "Aimbot.aimbotKey", "Aimbot.aimbotKeyMode", true)
        if Aim.TriggerActive and now - Aim.LastTrigger >= 0.008 then
            Aim.LastTrigger = now
            local has = false
            -- The native source does not run its PF-specific cache in triggerbot.
            local triggerList = cache.Mode == "PF" and cache.Players or list
            for _, p in ipairs(triggerList) do
                if (App.Targets[p.name] or Aim.Eligible(p, true)) and not p.localPlayer then
                    if Aim.BestPart(p, center, get("Aimbot.fovRadius"), visible) then has = true; break end
                end
            end
            if has then
                if not Aim.Pending then Aim.Pending = now
                elseif (now - Aim.Pending) * 1000 >= get("Aimbot.triggerDelay") then
                    if App.API.mouse1click then App.API.mouse1click()
                    elseif not Aim.ClickWarned then Aim.ClickWarned = true; App.Message("Triggerbot requires mouse1click.") end
                    Aim.Pending = nil
                end
            else Aim.Pending = nil end
        elseif not Aim.TriggerActive then Aim.Pending = nil end
        if not Aim.Active then Aim.Locked = nil; return end
        if cache.Mode == "PF" and Aim.Locked then
            for _, p in ipairs(list) do
                if p.key == Aim.Locked and Aim.Eligible(p, false, true) then
                    local _, screen, world = Aim.BestPart(p, center, 999999, visible and not App.Targets[p.name])
                    if screen then Aim.Apply(p, screen, world, now); return end
                end
            end
            Aim.Locked = nil
        end
        local selected
        local needAcquire = cache.Mode == "PF" or not Aim.Locked or get("Aimbot.autoSwitch") or not get("Aimbot.stickyAim")
        if needAcquire and now - Aim.LastAcquire >= 0.008 then
            Aim.LastAcquire = now
            local mode360 = get("Aimbot.mode360") or get("Aimbot.mode360Key") ~= 0 and App.IsDown(get("Aimbot.mode360Key"))
            local best = mode360 and 1e9 or get("Aimbot.fovRadius")
            for _, p in ipairs(list) do
                if Aim.Eligible(p, false) then
                    local marked = App.Targets[p.name]
                    local _, screen = Aim.BestPart(p, center, marked and 1e9 or best, visible and not marked)
                    if screen then selected, best = p, marked and -1 or (screen - center).Magnitude end
                end
            end
            Aim.Locked = selected and selected.key or nil
        else for _, p in ipairs(list) do if p.key == Aim.Locked then selected = p; break end end end
        if not selected and Aim.Locked then for _, p in ipairs(list) do if p.key == Aim.Locked then selected = p; break end end end
        local part, screen, world
        if selected and Aim.Eligible(selected, false, true) then
            part, screen, world = Aim.BestPart(selected, center, 999999, visible and not App.Targets[selected.name])
        elseif not Aim.Locked and get("Aimbot.includeNPC") then
            local best = get("Aimbot.fovRadius")
            for _, entry in ipairs(cache.World) do
                if (entry.category == "animal" or entry.category == "soldier" or entry.category == "npc") and App.IsValid(entry.root)
                    and (not entry.hum or entry.hum.Health > 0) then
                    local point = Aim.Project(entry.root.Position)
                    if point and (point - center).Magnitude < best then
                        best = (point - center).Magnitude
                        selected = {source = "NPC", char = entry.node, key = 1, name = entry.name, root = entry.root, head = entry.head}
                        world, screen, part = entry.head.Position, point, entry.head
                    end
                end
            end
        end
        if not screen or not selected then Aim.Locked = nil; return end
        if selected.source ~= "PF" then world = Aim.Predict(selected, world, now); screen = Aim.Project(world, true) or screen end
        Aim.Part = part
        Aim.Apply(selected, screen, world, now)
        if now - (Aim.LastHistoryCleanup or 0) > 2 then
            Aim.LastHistoryCleanup = now
            for key, samples in pairs(Aim.History) do if #samples == 0 or now - samples[#samples].t > 2 then Aim.History[key] = nil end end
        end
    end
end


do
    local changes, frame = {}, 0
    App.Mutations = {}
    function App.Mutations.Begin() frame = frame + 1 end
    function App.Mutations.Write(owner, instance, property, value)
        if not instance then return end
        local properties = changes[instance] or {}; changes[instance] = properties
        local slot = properties[property]
        if not slot then slot = {original = instance[property], owners = {}}; properties[property] = slot end
        slot.owners[owner] = {value = value, frame = frame, order = App.Mutations.Order or 0}
        instance[property] = value
    end
    function App.Mutations.Finish(all)
        for instance, properties in pairs(changes) do
            for property, slot in pairs(properties) do
                local winner
                for owner, data in pairs(slot.owners) do
                    if all or data.frame ~= frame then slot.owners[owner] = nil
                    elseif not winner or data.order >= winner.order then winner = data end
                end
                if not winner then
                    pcall(function() instance[property] = slot.original end)
                    properties[property] = nil
                else
                    -- Reapply the final writer, matching the source loop order.
                    pcall(function() instance[property] = winner.value end)
                end
            end
            if next(properties) == nil or not App.IsValid(instance) then changes[instance] = nil end
        end
    end
    local Move = {FlyVelocity = Vector3.zero, Noclip = {}, Hip = {}, Hitbox = {}}
    App.Movement = Move
    local get, write, WS, M = App.Get, App.Mutations.Write, App.Workspace, App.Math
    function Move.Local()
        local character = App.LocalPlayer.Character
        return character, character and character:FindFirstChildOfClass("Humanoid"), character and character:FindFirstChild("HumanoidRootPart")
    end
    function Move.Velocity(owner, root, velocity)
        root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = velocity, Vector3.zero
    end
    function Move.Tick(dt)
        local character, hum, root = Move.Local()
        local camera = App.Camera
        local focus = App.IsFocused()
        App.Mutations.Order = 1
        local fly = focus and App.Gate("Movement.fly", "Movement.flyKey", "Movement.flyKeyMode") and root and camera
        if fly then
            write("Fly", WS, "Gravity", 0)
            local cf = camera.CFrame
            local forward = cf.LookVector
            forward = Vector3.new(forward.X, 0, forward.Z)
            forward = forward.Magnitude < 1e-6 and Vector3.new(0, 0, 1) or forward.Unit
            -- Preserve the source's right-vector signs rather than substituting a new movement basis.
            local right = Vector3.new(-cf.RightVector.X, cf.RightVector.Y, -cf.RightVector.Z)
            right = right.Magnitude < 1e-6 and Vector3.xAxis or right.Unit
            local speed = math.max(0, get("Movement.flySpeed"))
            local target = Vector3.zero
            if App.IsDown(87) then target = target + forward * speed end
            if App.IsDown(83) then target = target - forward * speed end
            if App.IsDown(65) then target = target + right * speed end
            if App.IsDown(68) then target = target - right * speed end
            local vertical = (App.IsDown(32) and 1 or 0) - (App.IsDown(17) and 1 or 0)
            target = target + Vector3.yAxis * vertical * speed * get("Movement.flyVerticalBoost")
            local method = get("Movement.flyMethod")
            if method == 1 or method == 2 then
                if target.Magnitude > 1e-6 then
                    local nextPosition = root.Position + target.Unit * speed * math.clamp(dt, 0.001, 0.05)
                    root.CFrame = method == 2 and CFrame.new(nextPosition) * cf.Rotation or CFrame.new(nextPosition) * root.CFrame.Rotation
                end
                Move.FlyVelocity = Vector3.zero
            elseif method == 3 then Move.FlyVelocity = Vector3.zero
            else Move.FlyVelocity = M.FlyVelocity(Move.FlyVelocity, target, math.max(0, get("Movement.flyDamping")), dt) end
            Move.Velocity("Fly", root, Move.FlyVelocity)
            Move.Flying = true
        else
            if Move.Flying and root then root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero end
            Move.Flying, Move.FlyVelocity = false, Vector3.zero
        end
        App.Mutations.Order = 2
        if character and App.Gate("Movement.noclip", "Movement.noclipKey", "Movement.noclipKeyMode") then
            if get("Movement.noclipMode") == 1 then if root then write("Noclip", root, "CanCollide", false) end
            else
                local parts = App.Cache.Parts(character)
                for name, part in pairs(parts) do
                    if name == "HumanoidRootPart" or name == "Head" or name:find("Torso") or name:find("Arm") or name:find("Hand") or name:find("Leg") or name:find("Foot") then write("Noclip", part, "CanCollide", false) end
                end
            end
        end
        App.Mutations.Order = 3
        local bunny = hum and App.Gate("Movement.bunnyHop", "Movement.bunnyHopKey", "Movement.bunnyHopKeyMode")
        if bunny then
            if App.IsDown(32) then Move.BunnySpeed = math.clamp(get("Movement.bunnyHopSpeed"), 16, 250); hum.Jump = true end
            if Move.BunnySpeed then write("BunnyHop", hum, "WalkSpeed", Move.BunnySpeed) end
        else Move.BunnySpeed = nil end
        App.Mutations.Order = 4
        if root and get("Movement.spiderman") then
            local velocity = root.AssemblyLinearVelocity
            if math.abs(velocity.X) > 0.5 or math.abs(velocity.Z) > 0.5 then root.AssemblyLinearVelocity = Vector3.new(velocity.X, 30, velocity.Z) end
        end
        App.Mutations.Order = 5
        if root and get("Movement.noFallDamage") then
            local velocity = root.AssemblyLinearVelocity
            if velocity.Y < -50 then root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z) end
        end
        App.Mutations.Order = 6
        if get("Movement.hitboxExpander") then
            for _, p in ipairs(App.Cache.Players) do
                if not p.localPlayer and App.Cache.Live(p) and (not get("Movement.hitboxTeamCheck") or not App.TeamCheck() or not App.Cache.Teammate(p))
                    and (not get("Movement.hitboxKnockCheck") or p.maxHealth <= 0 or p.health > 0) then
                    write("Hitbox", p.root, "Size", Vector3.new(get("Movement.hitboxX"), get("Movement.hitboxY"), get("Movement.hitboxZ")))
                    write("Hitbox", p.root, "CanCollide", false)
                end
            end
        end
        App.Mutations.Order = 7
        if hum and get("Movement.hipHeight") then
            if Move.HipHum ~= hum then Move.HipHum = hum; App.Set("Movement.hipHeightValue", hum.HipHeight, true) end
            write("HipHeight", hum, "HipHeight", get("Movement.hipHeightValue"))
        else Move.HipHum = nil end
        App.Mutations.Order = 8
        if hum and get("Misc.walkSpeed") then write("WalkSpeed", hum, "WalkSpeed", get("Misc.walkSpeedValue")) end
        App.Mutations.Order = 9
        if get("Misc.gravity") then write("Gravity", WS, "Gravity", get("Misc.gravityValue")) end
        App.Mutations.Order = 10
        if hum and App.Gate("Local.jumpEnabled", "Local.jumpKey", "Local.jumpKeyMode") then
            -- JumpPower is not substituted with a JumpHeight calculation.
            write("JumpPower", hum, "JumpPower", get("Local.jumpPower"))
        end
        App.Mutations.Order = 11
        if camera and App.Gate("Movement.fov", "Movement.fovKey", "Movement.fovKeyMode") then write("FOV", camera, "FieldOfView", get("Movement.fovValue")) end
    end
    local Free = {}
    App.Freecam = Free
    function Free.Tick(dt)
        local active = App.Camera and App.Gate("Freecam.enabled", "Freecam.key", "Freecam.keyMode")
        if not active then
            if Free.Active then App.Services.UserInputService.MouseBehavior = Free.MouseBehavior end
            Free.Active = false
            return
        end
        local camera = App.Camera
        local _, hum, root = Move.Local()
        if not Free.Active or Free.Camera ~= camera then
            Free.Camera, Free.Position = camera, root and root.Position or camera.CFrame.Position
            local cf = camera.CFrame
            local components = {cf:GetComponents()}
            Free.Yaw = math.atan2(-components[10], math.sqrt(components[4] ^ 2 + components[7] ^ 2))
            Free.Pitch = math.atan2(-components[9], components[8])
            Free.Root, Free.RootCFrame = root, root and root.CFrame
            Free.MouseBehavior = App.Services.UserInputService.MouseBehavior
            Free.Active = true
        end
        if App.IsFocused() and App.IsDown(2) then
            local delta = App.Services.UserInputService:GetMouseDelta()
            Free.Yaw = Free.Yaw - delta.X * get("Freecam.sensitivity")
            Free.Pitch = math.clamp(Free.Pitch - delta.Y * get("Freecam.sensitivity"), -1.48, 1.48)
            App.Services.UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        else App.Services.UserInputService.MouseBehavior = Free.MouseBehavior end
        local speed = get("Freecam.speed") * math.clamp(dt, 0.001, 0.05) * 60
        local cy, sy, cp, sp = math.cos(Free.Yaw), math.sin(Free.Yaw), math.cos(Free.Pitch), math.sin(Free.Pitch)
        local forward, right = Vector3.new(-sy * cp, sp, -cy * cp), Vector3.new(cy, 0, -sy)
        if App.IsFocused() then
            if App.IsDown(87) then Free.Position = Free.Position + forward * speed end
            if App.IsDown(83) then Free.Position = Free.Position - forward * speed end
            if App.IsDown(65) then Free.Position = Free.Position - right * speed end
            if App.IsDown(68) then Free.Position = Free.Position + right * speed end
            if App.IsDown(32) then Free.Position = Free.Position + Vector3.yAxis * speed end
            if App.IsDown(17) then Free.Position = Free.Position - Vector3.yAxis * speed end
        end
        App.Mutations.Order = 20
        write("Freecam", camera, "CameraType", Enum.CameraType.Scriptable)
        write("Freecam", camera, "CFrame", M.FreecamFrame(Free.Pitch, Free.Yaw, Free.Position))
        if get("Freecam.freezeCharacter") then
            if hum then write("Freecam", hum, "WalkSpeed", 0) end
            if root then
                if Free.Root ~= root then Free.Root, Free.RootCFrame = root, root.CFrame end
                write("Freecam", root, "Anchored", true)
