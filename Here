                        local sent, response = pcall(App.API.request, {Url = "https://assetdelivery.roblox.com/v1/asset/?id=" .. id, Method = "GET"})
                        if sent and type(response) == "table" and response.StatusCode == 200 and type(response.Body) == "string" and #response.Body <= 16 * 1024 * 1024 then
                            local saved, result = App.Config.Dump("image_" .. id .. ".asset", response.Body)
                            table.insert(lines, "  " .. (saved and "saved" or result))
                        else table.insert(lines, "  not downloadable for this session") end
                    end
                end
                if App.Alive then App.ExportText("Image asset export", #lines > 0 and table.concat(lines, "\n") or "No image asset references found.", "images.txt") end
            end)
            Explorer.Busy = false
            if not ok and App.Alive then App.Message("Image export: " .. tostring(issue):sub(1, 110)) end
        end)
