    end
    local lighting = App.Services.Lighting
    local lightingFields = {
        {enable = "clockTimeEnabled", props = {ClockTime = "clockTimeValue"}},
        {enable = "brightnessEnabled", props = {Brightness = "brightnessValue"}},
        {enable = "ambientEnabled", props = {Ambient = "ambientColor", OutdoorAmbient = "outdoorAmbientColor", ColorShift_Top = "outdoorAmbientColor", ColorShift_Bottom = "ambientColor"}},
        {enable = "fogEnabled", props = {FogStart = "fogStart", FogEnd = "fogEnd", FogColor = "fogColor"}},
        {enable = "exposureEnabled", props = {ExposureCompensation = "exposureValue"}},
    }
    function App.TickLighting()
